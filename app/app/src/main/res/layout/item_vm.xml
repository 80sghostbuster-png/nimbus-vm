<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="#16181E"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/vmName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#F4F1EA"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/vmMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#C8C4BB"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/vmMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#2A2D36"
            android:text="More"
            android:textAllCaps="false"
            android:textColor="#F4F1EA" />

        <Button
            android:id="@+id/vmRun"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#C7A452"
            android:text="Run"
            android:textAllCaps="false"
            android:textColor="#0E1014" />
    </LinearLayout>
</LinearLayout>
