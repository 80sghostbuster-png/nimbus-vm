<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.lex.nimbusvm.VncView
        android:id="@+id/screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="16dp"
        android:text="Starting…"
        android:textColor="#F4F1EA"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/bootOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="8dp"
        android:background="#CC0E1014"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/bootOverlayTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Booting… (firmware)"
            android:textColor="#C7A452"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bootOverlayBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Guest display is not active yet. The machine is still booting — open Serial for the live firmware and installer log."
            android:textColor="#F4F1EA"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#990E1014"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnHide"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:backgroundTint="#2A2D36"
                    android:minWidth="0dp"
                    android:text="Hide"
                    android:textAllCaps="false"
                    android:textColor="#F4F1EA"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnTouch"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#2A2D36"
                    android:minWidth="0dp"
                    android:text="Touch"
                    android:textAllCaps="false"
                    android:textColor="#F4F1EA"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnSerial"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#2A2D36"
                    android:minWidth="0dp"
                    android:text="Serial"
                    android:textAllCaps="false"
                    android:textColor="#F4F1EA"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnKeyboard"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#C7A452"
                    android:minWidth="0dp"
                    android:text="Keyboard"
                    android:textAllCaps="false"
                    android:textColor="#0E1014"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnPower"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#2A2D36"
                    android:minWidth="0dp"
                    android:text="Power"
                    android:textAllCaps="false"
                    android:textColor="#F4F1EA"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/serialPanel"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_gravity="bottom"
        android:background="#E00E1014"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/btnJumpLatest"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="end"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#C7A452"
            android:minWidth="0dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="Jump to latest"
            android:textAllCaps="false"
            android:textColor="#0E1014"
            android:textSize="11sp"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/serialScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/serialLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="8dp"
                android:text=""
                android:textColor="#B8C0C8"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </ScrollView>
    </LinearLayout>

    <com.lex.nimbusvm.OnScreenKeyboard
        android:id="@+id/osk"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_gravity="bottom"
        android:visibility="gone" />
</FrameLayout>
