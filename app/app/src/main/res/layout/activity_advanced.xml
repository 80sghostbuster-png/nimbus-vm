<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1014">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Advanced"
            android:textColor="#C7A452"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Name"
            android:textColor="#C8C4BB" />

        <EditText
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:textColor="#F4F1EA"
            android:textColorHint="#8A8680" />

        <TextView
            android:id="@+id/ramVal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="RAM"
            android:textColor="#C8C4BB" />

        <SeekBar
            android:id="@+id/ram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/cpuVal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="CPUs"
            android:textColor="#C8C4BB" />

        <SeekBar
            android:id="@+id/cpu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/diskVal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Disk"
            android:textColor="#C8C4BB" />

        <SeekBar
            android:id="@+id/disk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Switch
            android:id="@+id/x86"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="x86-64 compatibility (slow)"
            android:textColor="#F4F1EA" />

        <TextView
            android:id="@+id/x86Warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="An x86-64 guest on this ARM phone will be much slower than ARM64. Use only if you have no ARM image."
            android:textColor="#E8B86A"
            android:textSize="12sp"
            android:visibility="gone" />

        <Switch
            android:id="@+id/isoAttached"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Boot from ISO (uncheck to eject and boot the disk)"
            android:textColor="#F4F1EA" />

        <Switch
            android:id="@+id/share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Shared folder (virtio-9p, mount tag share)"
            android:textColor="#F4F1EA" />

        <Switch
            android:id="@+id/tpm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="TPM 2.0 (needed for Windows 11)"
            android:textColor="#F4F1EA" />

        <Switch
            android:id="@+id/secureBoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Secure Boot firmware"
            android:textColor="#F4F1EA" />

        <TextView
            android:id="@+id/bootRecoveryLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Installer recovery (experimental)"
            android:textColor="#C8C4BB" />

        <Spinner
            android:id="@+id/bootRecovery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="If Serial stops growing for 60 seconds (even after the kernel has started), auto-fallback restarts with the next profile. The default installer CPU is now cortex-a72 + thread=single; the old max+thread=multi profile is still listed as Legacy 0.2.5."
            android:textColor="#8A8680"
            android:textSize="12sp" />

        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#C7A452"
            android:text="Start VM"
            android:textAllCaps="false"
            android:textColor="#0E1014"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2A2D36"
            android:text="Save without starting"
            android:textAllCaps="false"
            android:textColor="#F4F1EA" />
    </LinearLayout>
</ScrollView>
